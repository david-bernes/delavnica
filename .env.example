# delavnica — service configuration (all values optional; defaults shown).
# Copy to .env and adjust, or export the variables in the environment.

# Approved pretrained checkpoint name (resolved into YOLO_WEIGHTS_DIR) or an
# absolute path to a local weights file. Not selectable by HTTP clients.
YOLO_MODEL=yolo26n.pt
# MUST be "cpu" — any other value is rejected at startup (project invariant INV-02).
YOLO_DEVICE=cpu
# Inference input size in pixels.
YOLO_IMAGE_SIZE=640
# Confidence threshold in [0, 1].
YOLO_CONFIDENCE=0.25
# Maximum number of detections returned per image.
YOLO_MAX_DETECTIONS=100
# Maximum compressed upload size in bytes (8 MiB).
MAX_UPLOAD_BYTES=8388608
# Maximum decoded image size in pixels (24 MP).
MAX_IMAGE_PIXELS=24000000
# Maximum simultaneous inferences; excess requests receive HTTP 429.
INFERENCE_CONCURRENCY=1
# Optional fixed PyTorch intra-op thread count (default: PyTorch auto-selects).
#TORCH_NUM_THREADS=8
# Local weights directory used to resolve bare model names (offline demos).
#YOLO_WEIGHTS_DIR=/home/you/.cache/ultralytics/weights
# Network bind address. Loopback by default (INV-07); LAN exposure requires
# explicit approval, route configuration and a real remote-client test.
HOST=127.0.0.1
PORT=8000
